# Copy to .env.local and fill in real values for local development.
# See ARCHITECTURE.md and README.md for the full environments overview
# (local / staging / production).

# --- Database (Neon Postgres connection string) ---
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Auto-provided by Vercel on every deployment — never set this yourself.
# VERCEL_URL=

# --- Google OAuth (sign-in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App base URL (used in email links, Stripe checkout redirects, and
# metadataBase for SEO metadata) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Environment / SEO indexing switch (src/lib/env.ts) ---
# "production" = indexable (robots.txt allows crawling, meta robots =
#   index,follow). Set this in Vercel's Production environment only.
# "staging"    = not indexable. Set this in Vercel's staging-branch env.
# unset        = not indexable (safe default — covers real Vercel Previews
#   and local dev; no need to set this for local development).
# APP_ENV=production

# --- Staging access gate (src/proxy.ts) ---
# HTTP Basic Auth, only enforced when APP_ENV=staging (see above) AND both
# vars below are set — real access control, unlike noindex/robots.txt,
# which only stops search engines, not people who have the URL. Leave
# both unset for local dev and production (no-op either way).
# STAGING_BASIC_AUTH_USER=
# STAGING_BASIC_AUTH_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=

# Set to "log" to no-op email sending (logs instead of calling Resend) —
# used on staging so testing never emails real people. Leave unset for
# local dev and production.
# EMAIL_MODE=log

# --- Stripe ---
# Always sk_test_... outside of real production — see docs/stripe-testing.md.
STRIPE_SECRET_KEY=
# Publishable key paired with STRIPE_SECRET_KEY above (pk_test_... /
# pk_live_...) — safe to expose to the browser (NEXT_PUBLIC_), used by
# Stripe Connect embedded components (the payout/onboarding UI on
# /dashboard/wallet, /organizer/payments, and the org creation wizard).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Endpoint-specific — from `stripe listen` locally, or the Stripe Dashboard
# webhook endpoint's signing secret in staging/production.
STRIPE_WEBHOOK_SECRET=
# Only needed if you have a second webhook destination at the same URL
# scoped to "Connected accounts" (for account.updated) rather than "Your
# account" — Stripe signs each destination with its own secret, and
# src/app/api/stripe/webhook/route.ts checks both if both are set.
# STRIPE_WEBHOOK_SECRET_CONNECT=

# --- UploadThing (image uploads) ---
UPLOADTHING_TOKEN=

# --- Cron (optional) ---
# If unset, /api/cron/upcoming-events runs unauthenticated. Only relevant
# on Production Vercel deployments — Vercel Cron Jobs never fire on
# Preview/branch deployments (e.g. staging) regardless of this var.
# CRON_SECRET=

# --- Local-only convenience vars, never set in Vercel ---
# Read directly by scripts/*.mjs (not by the app itself):
#   PROD_DATABASE_URL    — lets migrate-*.mjs also run against prod
#   OLD_DATABASE_URL     — source DB for migrate-from-old-db.mjs
#   STAGING_DATABASE_URL — target for scripts/run-staging-migrations.mjs
